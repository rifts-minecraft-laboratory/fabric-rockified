{
	"schemaVersion": 1,
	"id": "rockified",
	"version": "${version}",
	"name": "Rockified",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/rockified/logo.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"fr.noahboos.rockified.Rockified"
		],
		"client": [
			"fr.noahboos.rockified.client.RockifiedClient"
		],
		"fabric-datagen": [
			"fr.noahboos.rockified.client.datagen.RockifiedDataGenerator"
		]
	},
	"mixins": [
		"rockified.mixins.json",
		{
			"config": "rockified.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}